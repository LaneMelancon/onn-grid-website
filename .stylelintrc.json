{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "color-no-hex": true,
    "selector-class-pattern": [
      "^[a-z][a-zA-Z0-9]*$",
      { "message": "Use camelCase class names in CSS Modules (e.g. .cardTitle)" }
    ],
    "at-rule-no-unknown": [true, { "ignoreAtRules": ["mixin", "define-mixin"] }],
    "function-no-unknown": [true, { "ignoreFunctions": ["rem", "em", "light-dark", "alpha", "lighten", "darken"] }],
    "custom-property-pattern": null,
    "value-keyword-case": ["lower", { "ignoreKeywords": ["currentColor"] }]
  },
  "overrides": [
    {
      "files": ["src/styles/tokens.css"],
      "rules": { "color-no-hex": null }
    }
  ]
}
